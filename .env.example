# Ключ OpenAI — ТОЛЬКО для локальной генерации иллюстраций.
# Используется скриптом scripts/generate-images.mjs, в клиентский код не попадает.
#
# Не коммитьте .env: он в .gitignore.
# Проще передавать ключ через переменную окружения, не создавая файл:
#   PowerShell:  $env:OPENAI_API_KEY = "sk-..."; node scripts/generate-images.mjs
#   bash:        OPENAI_API_KEY=sk-... node scripts/generate-images.mjs

OPENAI_API_KEY=sk-...
